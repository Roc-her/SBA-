---
type Review = [name: string, quote: string];

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
---

<div class="reviews-carousel" data-reviews-carousel>
  <div class="reviews-carousel__viewport">
    <ul class="reviews-carousel__track" data-reviews-track role="list">
      {reviews.map(([name, quote]) => (
        <li class="reviews-carousel__slide" role="listitem">
          <article class="reviews-carousel__card">
            <div class="reviews-carousel__card-head">
              <p class="reviews-carousel__label">Client note</p>
              <p class="reviews-carousel__stars" aria-label="5 star review">★★★★★</p>
            </div>
            <blockquote class="reviews-carousel__quote">
              <p>{quote}</p>
            </blockquote>
            <footer class="reviews-carousel__attribution">
              <span class="reviews-carousel__rule" aria-hidden="true"></span>
              <p class="reviews-carousel__name">{name}</p>
            </footer>
          </article>
        </li>
      ))}
    </ul>
  </div>

  <div class="reviews-carousel__controls">
    <button
      type="button"
      class="reviews-carousel__btn"
      data-reviews-prev
      aria-label="Show previous reviews"
    >
      <span aria-hidden="true">←</span>
    </button>

    <p class="reviews-carousel__status" data-reviews-status aria-live="polite">1 / 1</p>

    <button
      type="button"
      class="reviews-carousel__btn"
      data-reviews-next
      aria-label="Show next reviews"
    >
      <span aria-hidden="true">→</span>
    </button>
  </div>
</div>

<script>
  function initReviewsCarousel(root: HTMLElement) {
    const track = root.querySelector('[data-reviews-track]') as HTMLElement | null;
    const prevBtn = root.querySelector('[data-reviews-prev]') as HTMLButtonElement | null;
    const nextBtn = root.querySelector('[data-reviews-next]') as HTMLButtonElement | null;
    const status = root.querySelector('[data-reviews-status]') as HTMLElement | null;
    const slides = [...root.querySelectorAll('.reviews-carousel__slide')] as HTMLElement[];

    if (!track || !prevBtn || !nextBtn || !status || slides.length === 0) return;

    let page = 0;

    const getVisibleCount = () => (window.matchMedia('(min-width: 768px)').matches ? 2 : 1);

    const getGap = () => {
      const styles = window.getComputedStyle(track);
      return Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
    };

    const getPageCount = () => Math.max(1, Math.ceil(slides.length / getVisibleCount()));

    const clampPage = () => {
      page = Math.min(Math.max(page, 0), getPageCount() - 1);
    };

    const setButtons = () => {
      prevBtn.disabled = page <= 0;
      nextBtn.disabled = page >= getPageCount() - 1;
    };

    const setStatus = () => {
      status.textContent = `${page + 1} / ${getPageCount()}`;
    };

    const update = () => {
      clampPage();
      const visible = getVisibleCount();
      const slideWidth = slides[0].offsetWidth;
      const offset = page * visible * (slideWidth + getGap());
      track.style.transform = `translate3d(-${offset}px, 0, 0)`;
      setButtons();
      setStatus();
    };

    prevBtn.addEventListener('click', () => {
      page -= 1;
      update();
    });

    nextBtn.addEventListener('click', () => {
      page += 1;
      update();
    });

    const resizeObserver = new ResizeObserver(() => update());
    resizeObserver.observe(root);

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        page -= 1;
        update();
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        page += 1;
        update();
      }
    });

    update();
  }

  const boot = () => {
    document.querySelectorAll('[data-reviews-carousel]').forEach((root) => {
      initReviewsCarousel(root as HTMLElement);
    });
  };

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .reviews-carousel {
    --reviews-gap: 1.5rem;
  }

  .reviews-carousel__viewport {
    overflow: hidden;
    width: 100%;
  }

  .reviews-carousel__track {
    display: flex;
    gap: var(--reviews-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 500ms cubic-bezier(0.22, 0.8, 0.22, 1);
    will-change: transform;
  }

  .reviews-carousel__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .reviews-carousel__slide {
      flex: 0 0 calc((100% - var(--reviews-gap)) / 2);
      width: calc((100% - var(--reviews-gap)) / 2);
    }
  }

  .reviews-carousel__card {
    display: flex;
    min-height: 15.5rem;
    flex-direction: column;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--black-2);
    padding: 1.5rem;
    color: var(--offwhite);
    box-shadow: 0 22px 60px -42px rgba(228, 201, 126, 0.35);
  }

  @media (min-width: 768px) {
    .reviews-carousel__card {
      min-height: 16.5rem;
      padding: 1.65rem 1.75rem;
    }
  }

  .reviews-carousel__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .reviews-carousel__label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }

  .reviews-carousel__stars {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--gold-bright);
  }

  .reviews-carousel__quote {
    margin: 1.35rem 0 0;
    flex: 1;
    border: 0;
    padding: 0;
  }

  .reviews-carousel__quote p {
    margin: 0;
    font-family: 'Cormorant Garamond', ui-serif, Georgia, serif;
    font-size: clamp(1.15rem, 1.35vw, 1.35rem);
    line-height: 1.45;
    color: var(--offwhite);
  }

  .reviews-carousel__attribution {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.35rem;
    padding-top: 0.15rem;
  }

  .reviews-carousel__rule {
    display: block;
    width: 2.25rem;
    height: 1px;
    background-image: var(--grad-gold);
    flex-shrink: 0;
  }

  .reviews-carousel__name {
    margin: 0;
    font-family: 'Cormorant Garamond', ui-serif, Georgia, serif;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--offwhite);
  }

  .reviews-carousel__controls {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
  }

  .reviews-carousel__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(228, 201, 126, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    font-size: 1.1rem;
    line-height: 1;
    color: var(--gold-bright);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .reviews-carousel__btn:hover:not(:disabled) {
    border-color: var(--gold);
    background: rgba(228, 201, 126, 0.12);
    color: var(--offwhite);
    transform: translateY(-1px);
  }

  .reviews-carousel__btn:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .reviews-carousel__status {
    min-width: 5.5rem;
    margin: 0;
    text-align: center;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(242, 242, 240, 0.72);
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-carousel__track {
      transition: none;
    }
  }
</style>
