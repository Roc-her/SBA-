---
import {
  fetchVexurEnvelope,
  preparePrerenderedVexurHtml,
  vexurContactForm,
} from '../data/vexur';
import VexurHydrate from './VexurHydrate.astro';

const { class: className = '' } = Astro.props;

let envelope: Awaited<ReturnType<typeof fetchVexurEnvelope>> | null = null;

try {
  envelope = await fetchVexurEnvelope('contact', 800);
} catch (error) {
  console.warn('[SBA] Vexur contact prerender failed; falling back to client loader.', error);
}
---

<div class:list={['sba-vexur-contact', className]}>
  {
    envelope ? (
      <div set:html={preparePrerenderedVexurHtml(envelope.html, 'contact')} />
    ) : (
      <div
        class="vexur-widget"
        data-widget="contact"
        data-agent={vexurContactForm.agentId}
        data-loader={vexurContactForm.loader}
        data-theme={vexurContactForm.theme}
        data-primary-color={vexurContactForm.primaryColor}
        data-show-branding="true"
        data-consent="pending"
        data-vx-no-fallback="true"
        data-vx-param-form-widget-build-id={vexurContactForm.formWidgetBuildId}
        data-vx-param-form-id={vexurContactForm.formId}
        data-vx-param-v={vexurContactForm.version}
      />
    )
  }
</div>

{envelope && <VexurHydrate envelope={envelope} />}

<script>
  const dedupeContactWidget = (shell: Element) => {
    const host = shell.querySelector('.vexur-widget[data-widget="contact"], .vexur-widget[data-vx-widget="contact"]');
    if (!(host instanceof HTMLElement)) return;

    const nested = [...host.querySelectorAll(':scope > .vexur-widget')];
    if (nested.length <= 1) return;

    nested.slice(1).forEach((widget) => widget.remove());
  };

  const watchContactWidget = (shell: Element) => {
    const host = shell.querySelector('.vexur-widget[data-widget="contact"], .vexur-widget[data-vx-widget="contact"]');
    if (!(host instanceof HTMLElement) || host.dataset.vexurDedupeBound === 'true') return;

    host.dataset.vexurDedupeBound = 'true';
    const observer = new MutationObserver(() => dedupeContactWidget(shell));
    observer.observe(host, { childList: true });
    dedupeContactWidget(shell);
  };

  const initContactWidget = () => {
    document.querySelectorAll('.sba-vexur-contact').forEach((shell) => {
      watchContactWidget(shell);
    });
  };

  initContactWidget();
  document.addEventListener('astro:page-load', initContactWidget);
</script>

<style>
  .sba-vexur-contact > .vexur-widget > .vexur-widget:not(:first-child),
  .sba-vexur-contact .vexur-widget > .vexur-widget:not(:first-child) {
    display: none !important;
  }
</style>
