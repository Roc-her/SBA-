---
import { vexurCalendar, vexurEmbed } from '../data/vexur';
---

<dialog id="book-call-modal" class="book-call-modal" aria-label="Book a call with Sarah">
  <button type="button" class="book-call-modal__close" data-book-call-close aria-label="Close booking">
    <span aria-hidden="true">×</span>
  </button>
  <div
    class="vexur-widget"
    data-widget="calendar"
    data-agent={vexurCalendar.agentId}
    data-loader={vexurCalendar.loader}
    data-theme={vexurCalendar.theme}
    data-primary-color="#a4853f"
    data-show-branding="true"
    data-consent="pending"
    data-vx-no-fallback="true"
    data-vx-param-calendar-widget-build-id={vexurCalendar.buildId}
    data-vx-param-renderer={vexurCalendar.renderer}
    data-vx-param-v={vexurCalendar.version}
  />
</dialog>

<script>
  const modal = document.getElementById('book-call-modal');

  if (modal instanceof HTMLDialogElement) {
    const openModal = () => {
      if (typeof modal.showModal === 'function') modal.showModal();
    };

    const closeModal = () => modal.close();

    const bindBookCallTriggers = () => {
      document.querySelectorAll('[data-book-call-trigger]').forEach((trigger) => {
        if (trigger instanceof HTMLElement && trigger.dataset.bookCallBound === 'true') return;
        if (trigger instanceof HTMLElement) trigger.dataset.bookCallBound = 'true';
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          openModal();
        });
      });
    };

    const bindBookCallAnchors = () => {
      document.querySelectorAll('a[href="#book-call"], a[href$="#book-call"]').forEach((link) => {
        if (link instanceof HTMLAnchorElement && link.dataset.bookCallBound === 'true') return;
        if (link instanceof HTMLAnchorElement) link.dataset.bookCallBound = 'true';
        link.addEventListener('click', (event) => {
          event.preventDefault();
          const url = new URL(link.href, window.location.href);
          if (url.pathname === window.location.pathname) {
            history.replaceState(null, '', '#book-call');
          } else {
            window.location.assign(link.href);
            return;
          }
          openModal();
        });
      });
    };

    const openFromHash = () => {
      if (window.location.hash === '#book-call') openModal();
    };

    const dedupeCalendarWidget = () => {
      const host = modal.querySelector('.vexur-widget[data-widget="calendar"]');
      if (!(host instanceof HTMLElement)) return;

      const nested = [...host.querySelectorAll(':scope > .vexur-widget')];
      if (nested.length <= 1) return;

      nested.slice(1).forEach((widget) => widget.remove());
    };

    const watchCalendarWidget = () => {
      const host = modal.querySelector('.vexur-widget[data-widget="calendar"]');
      if (!(host instanceof HTMLElement) || host.dataset.vexurDedupeBound === 'true') return;

      host.dataset.vexurDedupeBound = 'true';
      const observer = new MutationObserver(dedupeCalendarWidget);
      observer.observe(host, { childList: true });
      dedupeCalendarWidget();
    };

    bindBookCallTriggers();
    bindBookCallAnchors();
    openFromHash();
    watchCalendarWidget();
    window.addEventListener('hashchange', openFromHash);
    document.addEventListener('astro:page-load', () => {
      bindBookCallTriggers();
      bindBookCallAnchors();
      openFromHash();
      watchCalendarWidget();
    });

    modal.querySelectorAll('[data-book-call-close]').forEach((btn) => {
      btn.addEventListener('click', closeModal);
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    modal.addEventListener('cancel', closeModal);
  }
</script>

<style>
  .book-call-modal {
    position: relative;
    width: min(100% - 1.5rem, 42.5rem);
    max-height: calc(100vh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: auto;
  }

  .book-call-modal::backdrop {
    background: rgba(11, 11, 11, 0.72);
    backdrop-filter: blur(4px);
  }

  .book-call-modal__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: rgba(11, 11, 11, 0.06);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
  }

  .book-call-modal__close:hover {
    background: rgba(228, 201, 126, 0.25);
  }

  .book-call-modal .vexur-widget {
    width: 100%;
    max-width: 42.5rem;
  }

  /* Vexur v2 injects nested widgets; hide any duplicate siblings until JS removes them */
  .book-call-modal > .vexur-widget > .vexur-widget:not(:first-child) {
    display: none !important;
  }
</style>
