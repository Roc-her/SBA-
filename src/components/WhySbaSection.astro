---
import LuxuryPillarList from './LuxuryPillarList.astro';
import { liveSiteImages } from '../data/liveSiteImages';

const pillars = [
  {
    title: 'Honest guidance',
    copy: 'Clear advice you can trust — even when the right move is to pause, adjust, or walk away.',
  },
  {
    title: 'Protection before property',
    copy: 'Strategy and due diligence come first, so your capital and confidence stay guarded before excitement takes over.',
  },
  {
    title: 'Wealth should support life, not consume it',
    copy: 'Property should create more freedom and choice — not demand you sacrifice the life you are working hard to build.',
  },
  {
    title: 'Property without pressure',
    copy: 'No urgency tactics or sales scripts. Decisions stay calm, personal and paced to what is right for you.',
  },
  {
    title: 'Guidance without judgement',
    copy: 'Where you are today is enough to start. There is no perfect buyer checklist — only your circumstances and goals.',
  },
  {
    title: 'Calm confidence',
    copy: 'Relief and clarity matter as much as the outcome. You should feel steady and protected, not steamrolled.',
  },
];
---

<section class="why-sba signature-dark signature-accent border-t border-line-dark" aria-labelledby="why-sba-heading">
  <div class="signature-accent__glow" aria-hidden="true"></div>
  <div class="signature-accent__line" aria-hidden="true"></div>

  <div class="section-shell signature-accent__inner why-sba__shell">
    <div class="why-sba__intro scroll-reveal">
      <p class="section-kicker justify-center text-gold-bright">Why SBA</p>
      <p id="why-sba-heading" class="why-sba__lead">
        SBA exists for capable buyers who want personal, trustworthy guidance — not more noise, pressure, or sales talk.
      </p>
    </div>

    <div class="why-sba__stage scroll-reveal" style="--reveal-delay: 80ms">
      <LuxuryPillarList pillars={pillars} aria-label="SBA philosophy" />

      <figure class="why-sba__figure">
        <div class="why-sba__frame">
          <img
            src={liveSiteImages.whySbaSarah}
            alt="Sarah Smith enjoying a calm moment with a cup of tea"
            class="why-sba__photo"
            width="960"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .why-sba__shell {
    padding-block: 2.75rem 3.25rem;
  }

  @media (min-width: 768px) {
    .why-sba__shell {
      padding-block: 3.25rem 4rem;
    }
  }

  .why-sba__intro {
    margin-inline: auto;
    max-width: 44rem;
    text-align: center;
  }

  .why-sba__lead {
    margin-top: 1rem;
    margin-inline: auto;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--offwhite);
  }

  @media (min-width: 768px) {
    .why-sba__lead {
      font-size: 1.125rem;
      line-height: 1.8;
    }
  }

  .why-sba__stage {
    margin-top: 2rem;
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .why-sba__stage {
      margin-top: 2.5rem;
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 25.5rem);
      gap: 2rem 2.25rem;
      align-items: center;
    }
  }

  .why-sba__stage .luxury-pillar__text {
    max-width: 34rem;
  }

  .why-sba__figure {
    margin: 0 auto;
    width: min(100%, 21.85rem);
    align-self: center;
  }

  @media (min-width: 900px) {
    .why-sba__figure {
      margin: 0;
      margin-left: auto;
      width: 100%;
      max-width: 25.3rem;
      justify-self: end;
      align-self: center;
    }
  }

  .why-sba__frame {
    position: relative;
    overflow: hidden;
    border-radius: 0.85rem;
    padding: 1px;
    background-image: var(--grad-gold);
    box-shadow:
      0 28px 70px -40px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(228, 201, 126, 0.08);
  }

  .why-sba__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgba(11, 11, 11, 0.35) 100%);
    pointer-events: none;
  }

  .why-sba__photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Subject sits left in source — anchor left-of-centre to centre her in frame */
    object-position: 36% center;
    transform: scale(1.08);
    transform-origin: 36% center;
    filter: grayscale(1) contrast(1.05);
  }

  @media (min-width: 900px) {
    .why-sba__photo {
      aspect-ratio: 3 / 4;
      min-height: 32.2rem;
      object-position: 34% center;
      transform: scale(1.1);
      transform-origin: 34% center;
    }
  }
</style>
