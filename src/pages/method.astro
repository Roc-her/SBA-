---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';

const chartSteps = [
  ['5', 'Courage', '40%'],
  ['4', 'Strategy', '55%'],
  ['3', 'Protection', '70%'],
  ['2', 'Mindset', '85%'],
  ['1', 'Decision', '100%'],
];

const methodSteps = [
  ['5', 'Minutes of Courage', 'One honest conversation that names the decision.'],
  ['4', 'Pillars of Strategy', 'Budget, brief, location and life fit.'],
  ['3', 'Layers of Protection', 'Data, contract risk and emotional bias tested.'],
  ['2', 'Mindset Shifts', 'From panic to process; walking away is valid.'],
  ['1', 'Confident Decision', 'Clear enough to act, pause or stop.'],
];

const philosophyRows = [
  ['01', 'Noise is not', 'research.', 'More opinions do not always create better decisions.'],
  ['02', 'Urgency is not', 'strategy.', 'Pressure should be tested before it is trusted.'],
  ['03', 'Protection is', 'progress.', 'Avoiding the wrong purchase is a successful outcome.'],
];
---

<Layout
  title="The 5-4-3-2-1 Method | SBA Buyers Agency"
  description="Sarah Smith's 5-4-3-2-1 Method is a calm property decision-making framework."
>
  <section class="signature-dark">
    <div class="section-shell grid min-h-[440px] items-center gap-10 pb-12 pt-9 lg:grid-cols-[1fr_0.86fr] lg:gap-14">
      <div class="scroll-reveal max-w-[760px]">
        <p class="section-kicker text-gold-bright">The 5-4-3-2-1 Method</p>
        <h1 class="mt-5 text-6xl sm:text-7xl">
          A process built on protection, clarity and <em class="gold-text italic">confidence.</em>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-soft-light">
          Confidence comes from process, not knowing everything.
        </p>
      </div>

      <div class="scroll-reveal hidden lg:block" style="--reveal-delay: 140ms" aria-label="5-4-3-2-1 Method progress chart">
        <div class="relative ml-auto max-w-[540px] overflow-hidden rounded-[1.35rem] border border-line-dark bg-black-2/70 p-7 shadow-soft backdrop-blur">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_72%_18%,rgba(228,201,126,.13),transparent_16rem)]"></div>
          <div class="relative grid h-[300px] grid-cols-5 items-end gap-5 border-b border-line-dark px-2 pb-8">
            {chartSteps.map(([number, label, height]) => (
              <div class="group flex h-full min-w-0 flex-col items-center justify-end">
                <div
                  class="flex w-full max-w-[3.7rem] flex-col items-center transition duration-300 group-hover:-translate-y-1 group-hover:brightness-110"
                  style={`height: ${height}`}
                >
                  <p class="mb-2 font-serif text-5xl leading-none gold-text transition duration-300 group-hover:brightness-125">
                    {number}
                  </p>
                  <div
                    class="w-full flex-1 rounded-t-[1.15rem] bg-[linear-gradient(180deg,#E4C97E_0%,#C2A05B_48%,#9C7C38_100%)] opacity-90 shadow-[0_0_28px_-14px_rgba(228,201,126,.9)] transition duration-300 group-hover:opacity-100 group-hover:shadow-[0_0_34px_-10px_rgba(228,201,126,1)]"
                    aria-hidden="true"
                  ></div>
                </div>
                <p class="absolute bottom-3 text-center text-[0.58rem] font-semibold uppercase tracking-[0.1em] text-gold-bright">
                  {label}
                </p>
              </div>
            ))}
          </div>
          <p class="relative mt-5 text-xs font-semibold uppercase tracking-[0.18em] text-soft-light">
            Building from one conversation to one confident decision.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="signature-dark border-t border-line-dark">
    <div class="section-shell py-16">
      <div class="scroll-reveal mb-8 max-w-3xl">
        <p class="section-kicker text-gold-bright">The Method, step by step</p>
        <h2 class="mt-4 text-5xl sm:text-6xl">
          Five steps down to one clear <em class="gold-text italic">decision.</em>
        </h2>
      </div>

      <div class="relative max-w-5xl pl-[38px]">
        <span class="absolute bottom-5 left-[1rem] top-5 w-[2px] bg-[linear-gradient(180deg,rgba(228,201,126,.18),rgba(228,201,126,.5),rgba(164,133,63,.5),rgba(164,133,63,.18))]" aria-hidden="true"></span>
        <div class="divide-y divide-line-dark">
          {methodSteps.map(([number, title, copy], index) => (
            <article class="group relative py-3.5 transition duration-300 hover:translate-x-1.5" style={`--reveal-delay: ${index * 55}ms`}>
              <span class="absolute left-[-2.1rem] top-1/2 z-10 size-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-gold bg-black transition duration-300 group-hover:scale-125 group-hover:border-transparent group-hover:bg-[linear-gradient(135deg,#E4C97E_0%,#C2A05B_45%,#9C7C38_100%)] group-hover:shadow-[0_0_22px_rgba(228,201,126,.5)]" aria-hidden="true"></span>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-4">
                <p class="font-serif text-[1.5rem] leading-none gold-text">{number}</p>
                <h3 class="text-[1.3rem] leading-tight text-offwhite">{title}</h3>
                <p class="text-sm leading-6 text-soft-light sm:pt-1">{copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section py-[70px] md:py-[70px]">
    <div class="section-shell">
      <div class="scroll-reveal relative overflow-hidden rounded-[20px] border border-line bg-white p-7 shadow-[0_34px_110px_-72px_rgba(11,11,11,.72)] md:p-[60px]">
        <div class="absolute inset-x-0 top-0 h-1 gold-fill" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-20 -top-24 size-72 rounded-full bg-[radial-gradient(circle,rgba(228,201,126,.16),transparent_68%)]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-24 size-80 rounded-full bg-[radial-gradient(circle,rgba(164,133,63,.13),transparent_68%)]" aria-hidden="true"></div>
        <p class="pointer-events-none absolute bottom-4 right-8 font-serif text-[6rem] italic leading-none text-transparent opacity-20 md:text-[11rem]" style="-webkit-text-stroke: 1px rgba(164,133,63,.58);" aria-hidden="true">
          calm.
        </p>

        <div class="relative">
          <div class="max-w-3xl">
            <p class="section-kicker">Philosophy</p>
            <h2 class="mt-4 max-w-[18ch] text-5xl sm:text-6xl">
              Strong decisions are calm before they are <em class="gold-text italic">confident.</em>
            </h2>
          </div>

          <div class="mt-9 border-y border-[#E6E6E3]">
            {philosophyRows.map(([number, lead, goldWord, explainer], index) => (
              <div class="group grid gap-4 border-b border-[#E6E6E3] py-6 transition duration-300 last:border-b-0 hover:translate-x-2 md:grid-cols-[6rem_1fr] md:items-start" style={`--reveal-delay: ${index * 70}ms`}>
                <p class="font-serif text-5xl leading-none gold-text">{number}</p>
                <div>
                  <h3 class="font-serif text-[2rem] leading-tight text-ink">
                    {lead} <em class="gold-text italic">{goldWord}</em>
                  </h3>
                  <p class="mt-2 text-sm leading-7 text-muted">{explainer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</Layout>
