---
import Layout from '../layouts/Layout.astro';
import BookCallTrigger from '../components/BookCallTrigger.astro';
import VexurContactForm from '../components/VexurContactForm.astro';
import { liveSiteImages } from '../data/liveSiteImages';
const instagramUrl = 'https://www.instagram.com/sarah_smith_buyers_agent';
const linkedInUrl = 'https://www.linkedin.com/in/sarah-smith-73b183345';
const facebookUrl =
  'https://www.facebook.com/people/Sarah-Smith-Regional-Vic-Most-Trusted-Buyers-Agent/61565111191180/';
---

<Layout
  title="Contact | SBA Buyers Agency"
  description="Book a call with SBA Buyers Agency or contact Sarah Smith in Bendigo, Victoria."
>
  <section class="signature-dark">
    <div class="section-shell grid items-center gap-10 pb-12 pt-9 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
      <div class="scroll-reveal">
        <p class="section-kicker text-gold-bright">Contact</p>
        <h1 class="mt-5 max-w-5xl text-6xl sm:text-7xl">
          You Do Not Need Everything Figured Out Before You <em class="gold-text italic">Reach Out.</em>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-soft-light">
          Start with one calm conversation and no obligation.
        </p>
      </div>

      <figure class="scroll-reveal ml-auto w-full max-w-[520px] justify-self-end" style="--reveal-delay: 120ms">
        <div class="rounded-[1.75rem] p-px gold-fill shadow-soft">
          <div class="overflow-hidden rounded-[1.65rem] bg-black">
            <img
              src={liveSiteImages.sarahWorking}
              alt="Sarah Smith from SBA Buyers Agency"
              class="contact-hero-photo aspect-[5/4] size-full object-cover object-[50%_42%]"
            />
          </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="page-section contact-actions">
    <div class="section-shell contact-actions__grid">
      <div class="contact-form-cell scroll-reveal">
        <VexurContactForm />
      </div>

      <aside class="contact-direct-card scroll-reveal" style="--reveal-delay: 100ms">
        <p class="section-kicker contact-direct-kicker">Direct contact</p>
        <h2 class="contact-panel-title contact-direct-title">
          Or reach Sarah <em class="gold-text">directly.</em>
        </h2>
        <p class="contact-direct-lead">
          Prefer to call, email or connect on social? Sarah is based in Bendigo and works across regional Victoria.
        </p>

        <ul class="contact-detail-list">
          <li class="contact-detail">
            <span class="contact-detail__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M6.5 4h2l1.5 4-2 1.2a11 11 0 0 0 5.8 5.8L15 13l4 1.5v2a2 2 0 0 1-2 2A13.5 13.5 0 0 1 4.5 6.5a2 2 0 0 1 2-2.5Z"></path>
              </svg>
            </span>
            <span>
              <span class="contact-detail__label">Phone</span>
              <a class="contact-detail__value" href="tel:0438784423">0438 784 423</a>
            </span>
          </li>
          <li class="contact-detail">
            <span class="contact-detail__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
            </span>
            <span>
              <span class="contact-detail__label">Email</span>
              <a class="contact-detail__value" href="mailto:sarah@sbabuyersagency.com">sarah@sbabuyersagency.com</a>
            </span>
          </li>
          <li class="contact-detail">
            <span class="contact-detail__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"></path>
                <circle cx="12" cy="10" r="2.2"></circle>
              </svg>
            </span>
            <span>
              <span class="contact-detail__label">Based in</span>
              <span class="contact-detail__value">Bendigo VIC 3555</span>
            </span>
          </li>
        </ul>

        <div id="book-call" class="contact-cta-box" aria-label="Book a call with Sarah">
          <p class="contact-cta-box__kicker">Prefer a quick call?</p>
          <p class="contact-cta-box__copy">
            Book a Five Minutes of Courage call: a calm conversation about your goals, with no pressure to move forward.
          </p>
          <BookCallTrigger class="contact-cta-box__btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="4" y="5" width="16" height="15" rx="2"></rect>
              <path d="M8 3v4M16 3v4M4 10h16"></path>
            </svg>
            Book a call with Sarah today
          </BookCallTrigger>
        </div>

        <div class="contact-follow">
          <p class="contact-follow__label">Follow</p>
          <div class="contact-social">
            <a class="contact-social__link" href={instagramUrl} rel="noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="4"></rect>
                <circle cx="12" cy="12" r="3.2"></circle>
                <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
            <a class="contact-social__link" href={linkedInUrl} rel="noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.94 8.9H3.8V20h3.14V8.9ZM5.37 4a1.82 1.82 0 1 0 0 3.64A1.82 1.82 0 0 0 5.37 4ZM20.2 13.88c0-3.17-1.69-5.22-4.43-5.22-1.55 0-2.59.84-3.02 1.65h-.04V8.9H9.7V20h3.14v-5.5c0-1.45.27-2.85 2.07-2.85 1.77 0 1.8 1.66 1.8 2.95V20h3.14v-6.12h.35Z"></path>
              </svg>
            </a>
            <a class="contact-social__link" href={facebookUrl} rel="noreferrer" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14.1 8.45V6.9c0-.75.5-.93.85-.93h2.16V2.63L14.14 2.6c-3.3 0-4.05 2.47-4.05 4.05v1.8H7.5v3.43h2.59V21h4.01v-9.12h2.72l.36-3.43H14.1Z"></path>
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  /* Slight zoom-out inside fixed hero frame (container size unchanged) */
  .contact-hero-photo {
    transform: scale(0.92);
    transform-origin: center 38%;
  }

  .contact-actions {
    padding-block: 2rem 3rem;
  }

  .contact-actions__grid {
    display: grid;
    gap: 1.25rem;
    max-width: 68rem;
  }

  @media (min-width: 1024px) {
    .contact-actions__grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      gap: 1.35rem;
    }
  }

  /* Matched card headings — form widget + direct contact */
  .contact-panel-title {
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .contact-panel-title .gold-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .contact-panel-title {
      font-size: 1.5rem;
    }
  }

  .contact-actions .sba-vexur-contact :is(h1, h2, h3, legend) {
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif !important;
    font-size: 1.375rem !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    letter-spacing: -0.02em !important;
    color: var(--ink) !important;
  }

  @media (min-width: 768px) {
    .contact-actions .sba-vexur-contact :is(h1, h2, h3, legend) {
      font-size: 1.5rem !important;
    }
  }

  /* Form column — single card from Vexur only (no extra site wrapper) */
  .contact-form-cell {
    display: flex;
    min-width: 0;
    height: 100%;
  }

  .contact-form-cell .sba-vexur-contact {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    border-radius: 0.85rem;
    border: 1px solid var(--line);
    background: #fff;
    padding: 1.65rem 1.85rem 1.75rem;
    box-shadow: 0 18px 50px -36px rgba(11, 11, 11, 0.18);
    overflow: hidden;
  }

  .contact-form-cell .sba-vexur-contact .vexur-widget {
    flex: 1;
    min-height: 0;
  }

  /* Restore bordered fields when widget renders in-page (not iframe) */
  .contact-actions .sba-vexur-contact :is(
      input:not([type='submit']):not([type='hidden']):not([type='checkbox']):not([type='radio']),
      textarea,
      select
    ) {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--line) !important;
    border-radius: 0.5rem !important;
    background: #fff !important;
    box-shadow: none !important;
    color: var(--ink);
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.4;
    min-height: 2.75rem;
    padding: 0.7rem 0.85rem;
  }

  .contact-actions .sba-vexur-contact textarea {
    min-height: 6.5rem;
    resize: vertical;
  }

  .contact-actions .sba-vexur-contact :is(input, textarea):focus {
    outline: none;
    border-color: var(--gold) !important;
    box-shadow: 0 0 0 3px rgba(228, 201, 126, 0.22);
  }

  .contact-form-cell .sba-vexur-contact :is(iframe) {
    min-height: 18.5rem !important;
    border: 0 !important;
  }

  /* Direct contact card */
  .contact-direct-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    border-radius: 0.85rem;
    border: 1px solid var(--line);
    background: #fff;
    padding: 1.65rem 1.85rem 1.75rem;
    box-shadow: 0 18px 50px -36px rgba(11, 11, 11, 0.18);
  }

  .contact-direct-kicker {
    margin-bottom: 0;
  }

  .contact-direct-title {
    margin-top: 0.55rem;
  }

  .contact-direct-lead {
    margin-top: 0.65rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .contact-detail-list {
    margin: 1.35rem 0 0;
    display: grid;
    gap: 1.35rem;
    list-style: none;
    padding: 0;
  }

  .contact-detail {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-bottom: 0.15rem;
  }

  .contact-detail + .contact-detail {
    padding-top: 0.15rem;
  }

  .contact-detail__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.45rem;
    background: rgba(228, 201, 126, 0.14);
    color: var(--gold-deep);
  }

  .contact-detail__icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .contact-detail__label {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .contact-detail__value {
    display: block;
    margin-top: 0.12rem;
    font-family: 'Cormorant Garamond', ui-serif, Georgia, serif;
    font-size: 1.2rem;
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color 160ms ease;
  }

  a.contact-detail__value:hover {
    color: var(--gold-deep);
  }

  .contact-cta-box {
    margin-top: 1.65rem;
    flex-shrink: 0;
    border-radius: 0.65rem;
    border: 1px solid rgba(194, 160, 91, 0.45);
    background: rgba(228, 201, 126, 0.1);
    padding: 1.35rem 1.4rem 1.4rem;
  }

  .contact-cta-box__kicker {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .contact-cta-box__copy {
    margin-top: 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .contact-cta-box__btn {
    margin-top: 1rem;
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 0;
    border-radius: 0.45rem;
    padding: 0.7rem 0.85rem;
    background-image: var(--grad-gold);
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--black);
    cursor: pointer;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
    box-shadow: 0 14px 30px -22px rgba(228, 201, 126, 0.9);
  }

  .contact-cta-box__btn svg {
    width: 1rem;
    height: 1rem;
  }

  .contact-cta-box__btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 36px -20px rgba(228, 201, 126, 1);
  }

  .contact-follow {
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .contact-follow__label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .contact-social {
    margin-top: 0.55rem;
    display: flex;
    gap: 0.5rem;
  }

  .contact-social__link {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.45rem;
    border: 1px solid rgba(194, 160, 91, 0.35);
    background: rgba(228, 201, 126, 0.12);
    color: var(--gold-deep);
    transition:
      transform 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .contact-social__link svg {
    width: 1rem;
    height: 1rem;
  }

  .contact-social__link:hover {
    transform: translateY(-1px);
    background-image: var(--grad-gold);
    color: var(--black);
  }
</style>
