---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { liveSiteImages } from '../data/liveSiteImages';

const calendlyUrl = 'https://calendly.com/sarah-sbabuyersagency';
const instagramUrl = 'https://www.instagram.com/sarah_smith_buyers_agent';
const linkedInUrl = 'https://www.linkedin.com/in/sarah-smith-73b183345';
const facebookUrl = 'https://www.facebook.com/people/Sarah-Smith-Regional-Vic-Most-Trusted-Buyers-Agent/61565111191180/';
---

<Layout
  title="Contact | SBA Buyers Agency"
  description="Book a call with SBA Buyers Agency or contact Sarah Smith in Bendigo, Victoria."
>
  <section class="signature-dark">
    <div class="section-shell grid items-center gap-10 pb-12 pt-9 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
      <div class="scroll-reveal">
        <p class="section-kicker text-gold-bright">Contact</p>
        <h1 class="mt-5 max-w-5xl text-6xl sm:text-7xl">
          Start the conversation with <em class="gold-text italic">Sarah.</em>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-soft-light">
          Book a call or send a message and Sarah will come back to you directly.
        </p>
      </div>

      <aside class="scroll-reveal relative overflow-hidden rounded-[1.35rem] border border-line-dark bg-black-2" style="--reveal-delay: 120ms">
        <img
          src={liveSiteImages.startHereSarah}
          alt="Sarah Smith from SBA Buyers Agency"
          class="aspect-[5/4] size-full object-cover object-[58%_42%]"
        />
        <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(11,11,11,.2),transparent_62%)]"></div>
      </aside>
    </div>
  </section>

  <section class="signature-dark no-diagonal-seam border-t border-line-dark">
    <div class="section-shell py-8 md:py-10">
      <div class="grid overflow-hidden rounded-[24px] border border-line-dark bg-black-2/72 shadow-[0_40px_120px_-70px_rgba(0,0,0,.95)] lg:grid-cols-[0.82fr_1.18fr]">
        <aside class="relative overflow-hidden border-b border-line-dark p-6 md:p-8 lg:border-b-0 lg:border-r">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_12%_8%,rgba(228,201,126,.16),transparent_18rem),radial-gradient(circle_at_90%_100%,rgba(164,133,63,.12),transparent_20rem)]" aria-hidden="true"></div>
          <div class="relative">
            <p class="section-kicker text-gold-bright">Contact details</p>
            <h2 class="mt-4 max-w-sm text-5xl leading-[0.98] sm:text-6xl">
              Start the conversation.
            </h2>
            <p class="mt-4 max-w-md text-sm leading-7 text-soft-light">
              Book a call or send a message and Sarah will come back to you directly.
            </p>

            <div class="mt-6 space-y-4 text-sm font-semibold text-offwhite">
              <a class="group flex items-center gap-4 transition hover:text-gold-bright" href="tel:0438784423">
                <span class="grid size-8 shrink-0 place-items-center rounded-full border border-gold/70 text-gold-bright transition group-hover:bg-gold group-hover:text-black">
                  <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M6.6 4.8 8.9 4l2.1 4.8-1.7 1.1a10.2 10.2 0 0 0 4.8 4.8l1.1-1.7 4.8 2.1-.8 2.3c-.3.9-1.1 1.5-2 1.4C9.8 18.2 4.8 13.2 4.2 5.8c-.1-.9.5-1.7 1.4-2Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                0438 784 423
              </a>
              <a class="group flex items-center gap-4 transition hover:text-gold-bright" href="mailto:sarah@sbabuyersagency.com">
                <span class="grid size-8 shrink-0 place-items-center rounded-full border border-gold/70 text-gold-bright transition group-hover:bg-gold group-hover:text-black">
                  <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M4.5 6.5h15v11h-15v-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                    <path d="m5 7 7 5.5L19 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                sarah@sbabuyersagency.com
              </a>
              <div class="flex items-center gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full border border-gold/70 text-gold-bright">
                  <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M12 21s6-5.4 6-11a6 6 0 0 0-12 0c0 5.6 6 11 6 11Z" stroke="currentColor" stroke-width="1.7"></path>
                    <circle cx="12" cy="10" r="2" stroke="currentColor" stroke-width="1.7"></circle>
                  </svg>
                </span>
                Bendigo VIC 3555
              </div>
            </div>

            <div class="mt-6 flex gap-3" aria-label="Social media">
              <a class="social-icon grid size-10 place-items-center rounded-full border border-gold text-gold-bright transition" href={instagramUrl} rel="noreferrer" aria-label="Instagram">
                <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                  <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"></rect>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
                  <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"></circle>
                </svg>
              </a>
              <a class="social-icon grid size-10 place-items-center rounded-full border border-gold text-gold-bright transition" href={linkedInUrl} rel="noreferrer" aria-label="LinkedIn">
                <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M6.94 8.9H3.8V20h3.14V8.9ZM5.37 4a1.82 1.82 0 1 0 0 3.64A1.82 1.82 0 0 0 5.37 4ZM20.2 13.88c0-3.17-1.69-5.22-4.43-5.22-1.55 0-2.59.84-3.02 1.65h-.04V8.9H9.7V20h3.14v-5.5c0-1.45.27-2.85 2.07-2.85 1.77 0 1.8 1.66 1.8 2.95V20h3.14v-6.12h.35Z"></path>
                </svg>
              </a>
              <a class="social-icon grid size-10 place-items-center rounded-full border border-gold text-gold-bright transition" href={facebookUrl} rel="noreferrer" aria-label="Facebook">
                <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M14.1 8.45V6.9c0-.75.5-.93.85-.93h2.16V2.63L14.14 2.6c-3.3 0-4.05 2.47-4.05 4.05v1.8H7.5v3.43h2.59V21h4.01v-9.12h2.72l.36-3.43H14.1Z"></path>
                </svg>
              </a>
            </div>

            <Button href={calendlyUrl} class="mt-7">
              Book a Call -&gt;
            </Button>
          </div>
        </aside>

        <div class="relative p-6 md:p-8">
          <div class="pointer-events-none absolute inset-x-0 top-0 h-px gold-fill" aria-hidden="true"></div>
          <div class="relative">
            <p class="section-kicker text-gold-bright">Get in touch</p>
            <h2 class="mt-3 text-4xl sm:text-5xl">Send Sarah a message.</h2>
            <p class="mt-3 max-w-xl text-sm leading-7 text-soft-light">
              Send your details and Sarah will get back to you shortly.
            </p>
          </div>

          <form class="mt-6 grid gap-4" name="contact" method="post" data-netlify="true">
            <input type="hidden" name="form-name" value="contact" />
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2 text-sm font-semibold text-offwhite">
                <span>Full Name <span class="sr-only">required</span><span class="text-gold-bright" aria-hidden="true">*</span></span>
                <input class="rounded-2xl border border-white/10 bg-white px-5 py-3 font-sans text-ink shadow-[inset_0_1px_0_rgba(255,255,255,.8)] transition placeholder:text-muted/70 focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/35" type="text" name="name" placeholder="Your name" autocomplete="name" required />
              </label>
              <label class="grid gap-2 text-sm font-semibold text-offwhite">
                Phone
                <input class="rounded-2xl border border-white/10 bg-white px-5 py-3 font-sans text-ink shadow-[inset_0_1px_0_rgba(255,255,255,.8)] transition placeholder:text-muted/70 focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/35" type="tel" name="phone" placeholder="Your phone number" autocomplete="tel" />
              </label>
            </div>
            <label class="grid gap-2 text-sm font-semibold text-offwhite">
              <span>Email <span class="sr-only">required</span><span class="text-gold-bright" aria-hidden="true">*</span></span>
              <input class="rounded-2xl border border-white/10 bg-white px-5 py-3 font-sans text-ink shadow-[inset_0_1px_0_rgba(255,255,255,.8)] transition placeholder:text-muted/70 focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/35" type="email" name="email" placeholder="your@email.com" autocomplete="email" required />
            </label>
            <label class="grid gap-2 text-sm font-semibold text-offwhite">
              What would you like help with?
              <select class="rounded-2xl border border-white/10 bg-white px-5 py-3 font-sans text-ink shadow-[inset_0_1px_0_rgba(255,255,255,.8)] transition focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/35" name="service">
                <option>Buying support</option>
                <option>Negotiation only</option>
                <option>Auction representation</option>
                <option>Vendor advocacy</option>
                <option>Strategic advisory</option>
              </select>
            </label>
            <label class="grid gap-2 text-sm font-semibold text-offwhite">
              <span>Message <span class="sr-only">required</span><span class="text-gold-bright" aria-hidden="true">*</span></span>
              <textarea class="min-h-28 rounded-2xl border border-white/10 bg-white px-5 py-3 font-sans text-ink shadow-[inset_0_1px_0_rgba(255,255,255,.8)] transition placeholder:text-muted/70 focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/35" name="message" placeholder="How can Sarah help?" required></textarea>
            </label>
            <div class="flex flex-wrap items-center gap-4 pt-1">
              <Button type="submit">Send Enquiry -&gt;</Button>
              <a class="text-sm font-semibold text-gold-bright transition hover:text-offwhite" href={calendlyUrl}>Or book directly -&gt;</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</Layout>
