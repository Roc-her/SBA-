---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { clientStories } from '../data/clientStories';
---

<Layout
  title="Client Stories | SBA Buyers Agency"
  description="Real client outcomes from SBA Buyers Agency — protection, clarity and confident property decisions across regional Victoria."
>
  <section class="signature-dark">
    <div class="section-shell pb-12 pt-9">
      <div class="scroll-reveal max-w-3xl">
        <p class="section-kicker text-gold-bright">Client stories</p>
        <h1 class="mt-5 text-6xl sm:text-7xl">
          Some of the best decisions are the ones you <em class="gold-text italic">don't</em> make.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-soft-light">
          These summaries reflect real patterns from Sarah's work — buyers who needed clarity, protection and someone in their corner rather than pressure to act.
        </p>
      </div>
    </div>
  </section>

  <section class="page-section pt-0">
    <div class="section-shell space-y-6">
      {clientStories.map((story, index) => (
        <article
          class="scroll-reveal overflow-hidden rounded-xl border border-line bg-white shadow-[0_22px_70px_-52px_rgba(11,11,11,.5)]"
          style={`--reveal-delay: ${index * 70}ms`}
        >
          <div class="h-1 gold-fill" aria-hidden="true"></div>
          <div class="grid gap-6 p-7 md:grid-cols-[minmax(0,1fr)_minmax(220px,0.55fr)] md:gap-10 md:p-8">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-deep">{story.tag}</p>
              <h2 class="mt-4 text-4xl leading-tight text-ink">{story.title}</h2>
              <p class="mt-4 text-[0.9375rem] leading-7 text-muted">{story.summary}</p>
              <ul class="mt-6 space-y-2">
                {story.bullets.map((bullet) => (
                  <li class="flex items-start gap-3 text-sm leading-6 text-muted">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
            <aside class="flex flex-col justify-center rounded-lg border border-line bg-off-white-2 p-6">
              <p class="text-[0.64rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">Outcome</p>
              <p class="mt-3 font-serif text-2xl leading-snug text-ink">{story.outcome}</p>
            </aside>
          </div>
        </article>
      ))}
    </div>
  </section>

  <FinalCTA />
</Layout>
