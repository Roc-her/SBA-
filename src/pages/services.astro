---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { liveSiteImages } from '../data/liveSiteImages';

const services = [
  {
    roman: 'I',
    title: 'Full Buyer\'s Advocacy',
    description: 'Strategy, search, due diligence, negotiation and settlement support.',
    who: 'Busy buyers who need capacity, clarity and protection.',
    image: liveSiteImages.propertyInterior,
  },
  {
    roman: 'II',
    title: 'Negotiation Only',
    description: 'Experienced negotiation once you have found the property.',
    who: 'Buyers who want emotion removed from price and terms.',
    image: liveSiteImages.propertyExterior,
  },
  {
    roman: 'III',
    title: 'Vendor Advocacy',
    description: 'Independent selling guidance across agent choice, fees and campaign feedback.',
    who: 'Sellers who want their interests represented clearly.',
    image: liveSiteImages.propertyOutdoor,
  },
  {
    roman: 'IV',
    title: 'Auction Representation',
    description: 'Calm bidding with a pre-agreed strategy and firm limits.',
    who: 'Buyers who need discipline in a high-pressure room.',
    image: liveSiteImages.sarahWorking,
  },
  {
    roman: 'V',
    title: 'Strategic Advisory',
    description: 'A focused clarity session before buying, waiting or changing direction.',
    who: 'People not ready to buy yet, but ready to think well.',
    image: liveSiteImages.sbaBook,
  },
];
---

<Layout
  title="Services | SBA Buyers Agency"
  description="Property buying, selling, negotiation, auction and advisory services from SBA Buyers Agency."
>
  <section class="signature-dark">
    <div class="section-shell grid items-center gap-10 pb-12 pt-9 lg:grid-cols-[1fr_0.78fr] lg:gap-14">
      <div class="scroll-reveal max-w-[680px]">
        <p class="section-kicker text-gold-bright">Services</p>
        <h1 class="mt-5 text-6xl sm:text-7xl">
          Support shaped around where you <em class="gold-text italic">are.</em>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-soft-light">
          Choose the level of advocacy that fits this decision.
        </p>
      </div>
      <figure class="scroll-reveal relative w-full justify-self-start lg:justify-self-end" style="--reveal-delay: 120ms">
        <div class="absolute -inset-4 rounded-[1.75rem] bg-[radial-gradient(circle_at_65%_20%,rgba(228,201,126,.2),transparent_18rem)] blur-xl"></div>
        <div class="relative ml-auto max-w-[520px] rounded-[1.5rem] p-px gold-fill shadow-soft">
          <div class="grid overflow-hidden rounded-[1.42rem] bg-black sm:grid-cols-[1.2fr_0.8fr]">
            <div class="relative min-h-[18rem]">
              <img
                src={liveSiteImages.regionalHome}
                alt="Modern regional property interior"
                class="absolute inset-0 size-full object-cover"
              />
              <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(11,11,11,.5),transparent_58%)]"></div>
            </div>
            <div class="grid min-h-[18rem] grid-rows-2 border-t border-line-dark sm:border-l sm:border-t-0">
              <img
                src={liveSiteImages.propertyStorm}
                alt="Regional Victoria property exterior"
                class="size-full object-cover"
              />
              <img
                src={liveSiteImages.propertyOutdoor}
                alt="Outdoor entertaining area"
                class="size-full border-t border-line-dark object-cover"
              />
            </div>
            <figcaption class="col-span-full border-t border-line-dark bg-black/90 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-bright">
                Strategy, search and protection across real properties
              </p>
            </figcaption>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="page-section">
    <div class="section-shell">
      <div class="scroll-reveal mb-8 max-w-3xl">
        <p class="section-kicker">What SBA can do</p>
        <h2 class="mt-4 text-5xl sm:text-6xl">
          Five ways to buy or sell with more <em class="gold-text italic">clarity.</em>
        </h2>
      </div>

      <div class="space-y-4">
        {services.map((service, index) => (
          <article
            class="scroll-reveal group relative overflow-hidden rounded-xl border border-line bg-white shadow-[0_18px_55px_-44px_rgba(11,11,11,.58)] transition duration-300 hover:-translate-y-[6px] hover:border-gold/70 hover:shadow-[0_34px_90px_-44px_rgba(11,11,11,.76)]"
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <span class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 gold-fill transition duration-300 group-hover:scale-y-100" aria-hidden="true"></span>
            <div class="grid gap-0 lg:grid-cols-[18rem_6rem_minmax(0,1fr)_minmax(15rem,0.82fr)] lg:items-stretch">
              <div class="border-b border-line bg-off-white-2 p-3 lg:border-b-0 lg:border-r">
                <div class="flex h-full min-h-[13rem] items-center justify-center overflow-hidden rounded-lg bg-white">
                  <img
                    src={service.image}
                    alt=""
                    class="max-h-full w-full object-contain transition duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              </div>

              <div class="flex items-center border-b border-line px-6 py-5 lg:border-b-0 lg:border-r lg:px-5">
                <p class="font-serif text-6xl leading-none gold-text">{service.roman}</p>
              </div>

              <div class="border-b border-line px-6 py-6 lg:border-b-0 lg:border-r lg:px-7">
                <p class="text-[0.64rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">Service</p>
                <h3 class="mt-3 text-4xl leading-tight">{service.title}</h3>
                <p class="mt-3 max-w-xl text-sm leading-7 text-muted">{service.description}</p>
              </div>

              <div class="flex flex-col justify-center px-6 py-6 lg:px-7">
                <p class="text-[0.64rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">Who it's for</p>
                <p class="mt-3 text-sm leading-7 text-muted">{service.who}</p>
                <div class="mt-5 h-px w-full bg-[linear-gradient(90deg,#C2A05B,rgba(194,160,91,0))]" aria-hidden="true"></div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA />
</Layout>
