---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { liveSiteImages } from '../data/liveSiteImages';
import { resources } from '../data/resources';

const filters = ['All', 'Free Guides', 'Calculators', 'Quizzes'];
---

<Layout
  title="Resources | SBA Buyers Agency"
  description="Free property guides, calculators and quizzes from SBA Buyers Agency."
>
  <section class="signature-dark">
    <div class="section-shell grid items-center gap-10 pb-12 pt-9 lg:grid-cols-[1fr_0.72fr] lg:gap-14">
      <div class="scroll-reveal max-w-[680px]">
        <p class="section-kicker text-gold-bright">Resources</p>
        <h1 class="mt-5 text-6xl sm:text-7xl">
          Learn at your own <em class="gold-text italic">pace.</em>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-soft-light">
          Not everyone is ready to buy today, and that is perfectly okay. These guides, tools and quizzes are here to help you feel more informed and confident at your own pace, without pressure to act before you are ready.
        </p>
      </div>
      <figure class="scroll-reveal relative justify-self-start lg:justify-self-end" style="--reveal-delay: 120ms">
        <div class="absolute -inset-5 rounded-[1.75rem] bg-[radial-gradient(circle_at_50%_50%,rgba(228,201,126,.18),transparent_18rem)] blur-xl"></div>
        <div class="relative max-w-[360px] rounded-[1.5rem] border border-line-dark bg-black-2 p-5 shadow-soft">
          <img
            src={liveSiteImages.sbaBook}
            alt="SBA buyer resource guide"
            class="aspect-[4/5] w-full rounded-[1rem] object-cover"
          />
          <figcaption class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-gold-bright">
            Free guides and practical tools
          </figcaption>
        </div>
      </figure>
    </div>
  </section>

  <section class="page-section">
    <div class="section-shell">
      <div class="scroll-reveal mb-8 max-w-3xl">
        <p class="section-kicker">Resource library</p>
        <h2 class="mt-4 text-5xl sm:text-6xl">
          Built to grow as buyers need better <em class="gold-text italic">questions.</em>
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-muted">
          Sarah's goal is not to convince you to buy property. It is to help you make better decisions, whether that means working together, downloading a guide, or simply leaving with more clarity than you had yesterday.
        </p>
      </div>

      <div class="mb-8 flex flex-wrap gap-3">
        {filters.map((filter) => (
          <button class="resource-filter btn-outline" type="button" data-filter={filter}>
            {filter}
          </button>
        ))}
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {resources.map((resource, index) => {
          const isLive = Boolean(resource.href) && !resource.comingSoon;
          const cardClass = [
            'resource-card scroll-reveal gold-card block rounded-lg p-7 transition duration-300',
            isLive && 'hover:-translate-y-1 hover:border-gold hover:shadow-soft',
            resource.comingSoon && 'resource-card--soon opacity-95',
          ];
          const inner = (
            <>
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-deep">{resource.group}</p>
                {resource.comingSoon && (
                  <span class="rounded-full border border-gold/35 bg-gold/10 px-2.5 py-0.5 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-gold-deep">
                    Coming soon
                  </span>
                )}
              </div>
              <h3 class="mt-5 text-4xl">{resource.title}</h3>
              <p class="mt-4 text-[0.9375rem] leading-7 text-muted">{resource.copy}</p>
              {isLive && (
                <p class="mt-5 text-xs font-semibold uppercase tracking-[0.18em] text-gold-deep">
                  Open tool →
                </p>
              )}
            </>
          );

          return isLive ? (
            <a href={resource.href} class:list={cardClass} data-group={resource.group} style={`--reveal-delay: ${index * 45}ms`}>
              {inner}
            </a>
          ) : (
            <article class:list={cardClass} data-group={resource.group} style={`--reveal-delay: ${index * 45}ms`}>
              {inner}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <FinalCTA />

  <script>
    const filters = document.querySelectorAll('.resource-filter');
    const cards = document.querySelectorAll('.resource-card');

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        const selected = filter.getAttribute('data-filter');
        cards.forEach((card) => {
          card.classList.toggle('hidden', selected !== 'All' && card.getAttribute('data-group') !== selected);
        });
      });
    });
  </script>
</Layout>
